# Resend API Key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email where quote requests are sent
CONTACT_TO_EMAIL=J.J.RENOS@hotmail.com

# "From" address (must be a verified domain in Resend, or use default)
